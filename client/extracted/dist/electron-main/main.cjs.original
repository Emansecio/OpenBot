      automations_forge_agnostic_mirrors: {
        client: true,
        default: false
      },
      managed_agents_enabled: {
        client: true,
        default: false
      },
      custom_agents_enabled: {
        client: true,
        default: false
      },
      agents_bugbot_bottom_upsell: {
        client: true,
        default: false
      },
      // Consolidated review-agents growth kit on the portal (shared enable CTAs,
