        return await recreate.call(base, args);
      }
    },
    ...forceRecreate == null ? {} : {
      forceRecreate: async () => {
        refuseWhilePaused();
        return await forceRecreate.call(base);
      }
    },
    ...issueLocalExecDaemonCredential == null ? {} : {
