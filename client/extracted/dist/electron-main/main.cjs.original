    isPaused,
    guard: (base) => wrapRemoteHostConnectorWithClientPause(base, isPaused),
    noteGateMayHaveChanged: sync,
    reapplyAfterCoordinatorLaunch: () => {
      coordinatorPaused = false;
      sync();
    }
  };
}
