      glass_cloud_agent_fork_from_turn: {
        client: true,
        default: true
      },
      cloud_agent_use_prewarmed_pods: {
        client: true,
        default: true
      },
      /** Glass StreamConversation compact-blob filter gate. */
      glass_cloud_blob_prefetch_bloom_filter: {
