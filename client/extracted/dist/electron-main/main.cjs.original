      "designer",
      "product-manager",
      "researcher",
      "data-scientist",
      "student",
      "marketer",
      "operations",
      "something-else"
    ];
    GlassFtuxFirstActionConfigByJobRoleSchema = external_exports.record(external_exports.string().max(100), GlassFtuxFirstActionRoleConfigSchema).superRefine((byJobRole, ctx) => {
      const allowed = new Set(GLASS_FTUX_FIRST_ACTION_JOB_ROLE_KEYS);
      for (const roleKey of Object.keys(byJobRole)) {
        if (!allowed.has(roleKey)) {
          ctx.addIssue({
            code: external_exports.ZodIssueCode.custom,
            message: `Unknown FTUX first-action job role key: ${roleKey}`,
            path: [roleKey]
          });
        }
      }
    });
