      { type: "separator" },
      isMac ? { role: "togglefullscreen" } : {
        label: "Toggle Full Screen",
        accelerator: "F11",
        click: () => options.applyWindowShortcut("fullscreen")
      }
    ]
  });
  template.push({ role: "windowMenu" });
  template.push({
    role: "help",
    submenu: [
