import { bridgeEdge, type EdgeClientTransport } from "@sand/dune/rpc";
import { contextBridge, ipcRenderer } from "electron";

import {
	DEV_CONTROLS_METHOD_TABLE,
	devControlsRpcContract,
	type SandDevControlsBridge,
} from "../shared/rpc/dev-controls.js";

const transport: EdgeClientTransport = {
	invoke: (channel, payload) => ipcRenderer.invoke(channel, payload),
	on: (channel, listener) => {
		const wrapped = (_event: unknown, payload: unknown): void => {
			listener(payload);
		};
		ipcRenderer.on(channel, wrapped);
		return () => {
			ipcRenderer.off(channel, wrapped);
		};
	},
};

const devControls: SandDevControlsBridge = bridgeEdge(
	devControlsRpcContract,
	DEV_CONTROLS_METHOD_TABLE,
	transport,
);

contextBridge.exposeInMainWorld("sand", { devControls });
