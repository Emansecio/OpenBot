const isDevRestartEnabled =
	process.env.SAND_RESTART_EXIT_CODE != null && process.env.SAND_RESTART_EXIT_CODE.length > 0;

const devRestart = isDevRestartEnabled
	? async (): Promise<void> => {
			await ipcRenderer.invoke("sand:dev-restart");
		}
	: undefined;

const attachProdBox = {
	async getStatus(): Promise<{
		preferred: boolean;
		active: boolean;
		prefsPath: string;
		updatedAtMs: number;
	}> {
		return await ipcRenderer.invoke("sand:attach-prod-box-status");
	},
	async setEnabled(
		enabled: boolean,
		options?: { isRestartMainApp?: boolean },
	): Promise<{
		preferred: boolean;
		active: boolean;
		prefsPath: string;
		updatedAtMs: number;
	}> {
		return await ipcRenderer.invoke("sand:attach-prod-box-set-enabled", {
			enabled,
			isRestartMainApp: options?.isRestartMainApp,
		});
	},
};

const initialExperimentSnapshot = ipcRenderer.sendSync(
	"sand:experiments-snapshot-sync",
) as SandExperimentsSnapshot | null;

const initialThemeState = ipcRenderer.sendSync("sand:theme-get-sync") as SandThemeState;

const initialEgressTunnelEnabled = ipcRenderer.sendSync("sand:egress-tunnel-get-sync") === true;
const initialWebauthnProxyEnabled = ipcRenderer.sendSync("sand:webauthn-proxy-get-sync") === true;
const initialEgressTunnelStatus = ipcRenderer.sendSync(
	"sand:egress-tunnel-status-get-sync",
) as SandEgressTunnelStatus;

const coordinatorPortBroker = createCoordinatorPortBroker({
	invokeRequest: () => {
		void ipcRenderer.invoke("sand:coordinator-port-request");
	},
});

const mainEdgeTransport: EdgeClientTransport = {
	invoke: (channel, payload) => ipcRenderer.invoke(channel, payload),
	on: (channel, listener) => {
		const wrapped = (_event: unknown, payload: unknown): void => {
			listener(payload);
		};
		ipcRenderer.on(channel, wrapped);
		return () => {
			ipcRenderer.off(channel, wrapped);
		};
	},
};

const mainEdge = bridgeEdge(mainRpcContract, MAIN_METHOD_TABLE, mainEdgeTransport);

