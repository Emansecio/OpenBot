const coordinatorPort = coordinatorPortBroker.bridge satisfies SandCoordinatorPortCapability;

contextBridge.exposeInMainWorld("desktop", desktop);
contextBridge.exposeInMainWorld("coordinatorPort", coordinatorPort);

// The channel name is spelled literally: importing coordinator-runtime.ts would drag it into this bundle.
ipcRenderer.on("sand:coordinator-port", (event) => {
	const port = event.ports[0];
	if (port == null) return;
	coordinatorPortBroker.deliver(wrapTransferredCoordinatorPort(port));
});
