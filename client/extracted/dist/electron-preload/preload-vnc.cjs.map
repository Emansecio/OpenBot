// The preload for the trusted box-desktop (noVNC) <webview>. It layers the
// host OS clipboard bridge, the macOS Cmd->Ctrl key remap, and the noVNC chrome
// hider on top of the generic browser preload. main.cts attaches this preload
// ONLY to the persist:sand-forever-box session partition, so untrusted in-app
// browser tabs never load the clipboard bridge at all.

"use strict";

import { bridgeEdge, type EdgeBridge, type EdgeClientTransport } from "@sand/dune/rpc";
import { createPollingPolicy } from "@sand/dune/scheduling";

import {
	BOX_VNC_METHOD_TABLE,
	boxVncRpcContract,
	type BoxVncRpcContract,
} from "../shared/rpc/vnc.js";
import { VNC_LIVENESS_CHANNEL } from "../shared/vnc-liveness.js";
import { VNC_VIEWER_VISIBLE_CHANNEL } from "../shared/vnc-viewer-visibility.js";
import { buildHostClipboardPasteScript, resolveHostToBoxSync } from "./box-vnc-clipboard-paste.js";
import {
	buildVncLivenessBeaconReadExpression,
	buildVncLivenessBeaconScript,
	createVncLivenessDetector,
	parseVncLivenessBeaconCounters,
} from "./box-vnc-liveness.js";
import { createViewerVisibilityGate } from "./box-vnc-visibility-gate.js";
import {
	getErrorMessage,
	getIpcRenderer,
	getWebFrame,
	installSandBrowserPreload,
	logWarn,
} from "./preload-browser-base.cjs";

function resolveBoxVncEdge(): EdgeBridge<BoxVncRpcContract> | null {
	const renderer = getIpcRenderer();
	if (renderer == null) return null;
	const transport: EdgeClientTransport = {
		invoke: (channel, payload) => renderer.invoke(channel, payload),
		on: (channel, listener) => {
			const wrapped = (_event: unknown, payload: unknown): void => {
				listener(payload);
			};
			renderer.on(channel, wrapped);
			return () => {
				renderer.off(channel, wrapped);
			};
		},
	};
	return bridgeEdge(boxVncRpcContract, BOX_VNC_METHOD_TABLE, transport);
}

function isInteractiveVncPage(): boolean {
	if (typeof location === "undefined") return false;
	if (!location.pathname.endsWith("/vnc.html")) return false;
	try {
		return new URLSearchParams(location.search).get("sandInteractive") === "1";
	} catch (_err) {
		return false;
	}
}

function getVncClipboardTextarea(): HTMLTextAreaElement | null {
	if (typeof document === "undefined") return null;
	const el = document.getElementById("noVNC_clipboard_text");
	return el instanceof HTMLTextAreaElement ? el : null;
}

function installNoVncChromeHider(): void {
	if (typeof location === "undefined") return;
	if (!location.pathname.endsWith("/vnc.html")) return;
	const css = `
    #noVNC_control_bar,
    #noVNC_control_bar_handle,
    #noVNC_control_bar_anchor,
    #noVNC_status,
    .noVNC_logo {
      display: none !important;
      pointer-events: none !important;
      visibility: hidden !important;
    }
  `;
	// webFrame.insertCSS returns the inserted stylesheet's key synchronously (it
	// is not a promise), so guard it with try/catch rather than .catch().
	try {
		getWebFrame()?.insertCSS(css);
	} catch (err) {
		logWarn("noVNC CSS injection failed", getErrorMessage(err));
	}

	function apply(): void {
		document.getElementById("noVNC_control_bar")?.classList.remove("noVNC_open");
	}

	if (typeof document === "undefined") return;
	apply();
	document.addEventListener("DOMContentLoaded", apply, { once: true });
	window.addEventListener("load", apply, { once: true });
}

function installVncClipboardBridge(): void {
	const renderer = getIpcRenderer();
	const bridge = resolveBoxVncEdge();
	if (renderer == null || bridge == null) return;
	const vncEdge = bridge;
	if (typeof window === "undefined" || typeof document === "undefined") return;
	if (!isInteractiveVncPage()) return;

	// noVNC fills its hidden #noVNC_clipboard_text textarea on ServerCutText, so
	// for box -> host we poll that textarea. For host -> box we call the live
	// rfb's clipboardPasteFrom directly (see mirrorHostClipboardToBox) rather than
	// firing noVNC's stock textarea `change` handler, which throws when rfb is
	// undefined mid-reconnect. Both directions bridge through the main process.
	const POLL_MS = 500;
	const GESTURE_THROTTLE_MS = 200;
	let lastBoxTextSentToHost = "";
	let lastHostTextSentToBox = "";
	let lastGestureAt = 0;
	const visibility = createViewerVisibilityGate();
	renderer.on(VNC_VIEWER_VISIBLE_CHANNEL, (_event, value: unknown) => {
		if (visibility.update(value)) mirrorHostClipboardToBox();
	});

	function mirrorBoxClipboardToHost(): void {
		if (!visibility.isVisible()) return;
		const textarea = getVncClipboardTextarea();
		if (textarea == null) return;
		const text = textarea.value;
		if (text.length === 0) return;
		// Ignore our own host->box writes echoed back and values already mirrored;
		// otherwise the unchanged textarea would re-send on every poll tick.
		if (text === lastHostTextSentToBox || text === lastBoxTextSentToHost) {
			return;
		}
		lastBoxTextSentToHost = text;
		void vncEdge.writeClipboard({ text }).catch((err: unknown) => {
			logWarn("vnc clipboard write failed", getErrorMessage(err));
		});
	}

	function mirrorHostClipboardToBox(): void {
		if (!visibility.isVisible()) return;
		const now = Date.now();
		if (now - lastGestureAt < GESTURE_THROTTLE_MS) return;
		lastGestureAt = now;
		vncEdge
			.readClipboard()
			.then((text) => {
				if (text.length === 0) return;
				const frame = getWebFrame();
				if (frame == null) return;
				// Paste straight into noVNC's live RFB in the page's main world instead
				// of poking the hidden textarea and firing noVNC's stock `change`
				// handler (UI.clipboardSend). That handler runs
				// `UI.rfb.clipboardPasteFrom(text)` unconditionally, and stock noVNC
				// clears UI.rfb on every disconnect, so a gesture during the reconnect
				// gap (or before the first connect) crashed the whole viewer. The
				// injected script guards on a live rfb, so an early/disconnected gesture
				// no-ops and a later gesture after reconnect still works.
				frame
					.executeJavaScript(buildHostClipboardPasteScript(text))
					.then((didPaste: unknown) => {
						const synced = resolveHostToBoxSync(text, didPaste === true);
						if (synced == null) return;
						// Commit the mirror state only once the text has actually reached
						// the box, and mirror it into the textarea the box->host poll reads.
						// This keeps the dedupe consistent with the real VM clipboard now
						// that the direct-RFB paste bypasses that textarea, so we never push
						// stale VM text back to the host or drop a genuine VM copy. Setting
						// .value (without dispatching `change`) never re-triggers the stock
						// handler, so it can't reintroduce the undefined-rfb crash.
						lastHostTextSentToBox = synced;
						const textarea = getVncClipboardTextarea();
						if (textarea != null) textarea.value = synced;
					})
					.catch((err) => {
						logWarn("vnc clipboard paste failed", getErrorMessage(err));
					});
			})
			.catch((err) => {
				logWarn("vnc clipboard read failed", getErrorMessage(err));
			});
	}

	// box -> host: noVNC assigns the textarea value programmatically (no input
	// event fires), so poll it. The payload is tiny and changes rarely.
	const clipboardPolling = createPollingPolicy({
		name: "vnc-clipboard-mirror",
		intervalMs: POLL_MS,
	}).start(async () => {
		mirrorBoxClipboardToHost();
	});

	// host -> box: prime the box clipboard whenever the user (re)engages with
	// the desktop, mirroring the cloud-agent viewer's focus/gesture sync.
	window.addEventListener("focus", mirrorHostClipboardToBox);
	document.addEventListener("mousedown", mirrorHostClipboardToBox, true);
	document.addEventListener("visibilitychange", () => {
		if (document.visibilityState === "visible") mirrorHostClipboardToBox();
	});
	window.addEventListener("pagehide", () => clipboardPolling.dispose(), {
		once: true,
	});
}

function installVncUserPresenceReporter(): void {
	const bridge = resolveBoxVncEdge();
	if (bridge == null) return;
	const vncEdge = bridge;
	if (typeof window === "undefined" || typeof document === "undefined") return;
	// Only the interactive desktop can be driven by the user; the watch-only
	// preview never competes with a real cursor, so it reports nothing.
	if (!isInteractiveVncPage()) return;
	if (document.documentElement == null) {
		document.addEventListener("DOMContentLoaded", () => installVncUserPresenceReporter(), {
			once: true,
		});
		return;
	}

	let lastSent: boolean | null = null;
	function report(isPresent: boolean): void {
		if (isPresent === lastSent) return;
		lastSent = isPresent;
		void vncEdge.reportUserPresence({ isPresent }).catch((err: unknown) => {
			logWarn("vnc user presence report failed", getErrorMessage(err));
		});
	}

	const root = document.documentElement;
	// mouseenter/leave on the root element fire as the pointer crosses the
	// desktop's viewport edge. noVNC capturing pointer moves on its canvas does
	// not suppress them (they don't bubble and are dispatched by geometry).
	root.addEventListener("mouseenter", () => report(true));
	root.addEventListener("mouseleave", () => report(false));
	// A pointer already inside on load (the user opened the modal and the desktop
	// reconnected under their cursor) emits no mouseenter, so any real movement
	// also marks presence.
	document.addEventListener("mousemove", () => report(true), { passive: true });
	// Leaving the app (alt-tab) or tearing the page down means the user is no
	// longer driving; clear presence so a stale "present" can't pin the cursor.
	window.addEventListener("blur", () => report(false));
	window.addEventListener("pagehide", () => report(false), { once: true });
}

function installVncHostKeyForwarder(): void {
	const renderer = getIpcRenderer();
	if (renderer == null) return;
	if (typeof document === "undefined") return;
	if (!isInteractiveVncPage()) return;

	// A focused <webview> routes every keydown into this guest, so the embedder's
	// own window/document handlers never see the modal's shortcuts. Re-emit the
	// few the modal owns back to the host via sendToHost (mirrors
	// VNC_HOST_KEY_CHANNEL in box-vnc.tsx):
	//   - Arrows: step the monitor list. NOT preventDefault'd — a single-desktop
	//     box still needs arrow keys, and the host only steps when >1 monitor, so
	//     forwarding-without-stealing keeps both behaviors.
	//   - Escape is deliberately NOT forwarded (or intercepted): the user drives
	//     the remote desktop through this guest and presses Escape at IT — its
	//     dialogs, its vim, its palettes — so the keystroke always belongs to
	//     the box. Leaving a presentation is the viewer chrome's job (mode
	//     menu / Close), never a side effect of a desktop keystroke.
	const FORWARDED_ARROWS = new Set(["ArrowUp", "ArrowDown", "ArrowLeft", "ArrowRight"]);
	document.addEventListener(
		"keydown",
		(event: KeyboardEvent) => {
			if (FORWARDED_ARROWS.has(event.key)) {
				try {
					renderer.sendToHost("sand:vnc-host-key", event.key);
				} catch (err) {
					logWarn("vnc host key forward failed", getErrorMessage(err));
				}
			}
		},
		true,
	);
}

// Reports noVNC's RFB session lifecycle (connect / disconnect / reconnect) up to
// the embedder (box-vnc.tsx), which forwards it to Datadog as sand.vnc_session —
// the RFB-level truth that separates a dead cached PREVIEW from an INTERACTIVE
// viewer that never connected from a flapping session. Runs for BOTH surfaces
// (preview + interactive), guarded only on being a noVNC page.
//
// noVNC drives its own CSS off connection-state classes it toggles on
// `document.documentElement` (`noVNC_connecting` / `noVNC_connected` /
// `noVNC_reconnecting` / `noVNC_disconnecting`). Observing those from the preload's
// isolated world (which shares the DOM) is far more robust than reaching into
// noVNC's ES-module `UI.rfb` — no module import (which fails from an injected
// script in this webview) and no main-world bridge. Best-effort and observe-only:
// it never touches the stream, and any failure just yields no RFB events (the
// webview-level dom_ready/load_fail edges in box-vnc.tsx and the LB 404 signal in
// main.cts still ship).
function installVncRfbSessionReporter(): void {
	const renderer = getIpcRenderer();
	if (renderer == null) return;
	const activeRenderer = renderer;
	if (typeof window === "undefined" || typeof document === "undefined") return;
	if (typeof location === "undefined") return;
	if (!location.pathname.endsWith("/vnc.html")) return;

	function report(phase: string, clean: boolean): void {
		try {
			activeRenderer.sendToHost("sand:vnc-session", JSON.stringify({ phase, clean }));
		} catch (err) {
			logWarn("vnc session report failed", getErrorMessage(err));
		}
	}

	let connectCount = 0;
	// True from a reported connect until its disconnect is reported, so exactly ONE
	// rfb_disconnect fires per drop even when the drop transitions through several
	// states (e.g. reconnecting -> disconnected on a failed auto-reconnect).
	let reportedConnected = false;
	let last: string | null = null;
	function currentState(): string {
		const c = document.documentElement.classList;
		if (c.contains("noVNC_connected")) return "connected";
		if (c.contains("noVNC_reconnecting")) return "reconnecting";
		if (c.contains("noVNC_connecting")) return "connecting";
		if (c.contains("noVNC_disconnecting")) return "disconnecting";
		return "disconnected";
	}
	function evaluate(): void {
		const state = currentState();
		if (state === last) return;
		last = state;
		if (state === "connected") {
			// First connect is `rfb_connect`; any later one (after a drop) is a
			// `reconnect` — keyed on connectCount, not on the flag below, so a failed
			// reconnect can't leave the flag set and double-count.
			connectCount += 1;
			report(connectCount > 1 ? "reconnect" : "rfb_connect", true);
			reportedConnected = true;
		} else if (reportedConnected && state !== "connecting") {
			// Left the connected state. Report the drop EXACTLY ONCE (clear the flag
			// immediately): `disconnecting` is a clean user/host teardown; a
			// `reconnecting`/`disconnected` exit is an unexpected drop. `connecting` is
			// skipped — it is the intermediate step of an auto-reconnect, not a drop.
			report("rfb_disconnect", state === "disconnecting");
			reportedConnected = false;
		}
	}

	function start(): void {
		const observer = new MutationObserver(evaluate);
		observer.observe(document.documentElement, {
			attributes: true,
			attributeFilter: ["class"],
		});
		// Catch a connection that was already established before the observer armed.
		evaluate();
		window.addEventListener("pagehide", () => observer.disconnect(), {
			once: true,
		});
	}
	// The preload runs at document-start, so documentElement may not exist yet;
	// DOMContentLoaded guarantees it, and noVNC's state classes only change
	// after its own scripts run, later still, so the observer misses nothing.
	if (document.documentElement == null) {
		document.addEventListener("DOMContentLoaded", () => start(), { once: true });
	} else {
		start();
	}
}

function installVncLivenessTripwire(): void {
	const renderer = getIpcRenderer();
	const frame = getWebFrame();
	if (renderer == null || frame == null) return;
	const activeRenderer = renderer;
	const activeFrame = frame;
	if (typeof window === "undefined" || typeof document === "undefined") return;
	if (!isInteractiveVncPage()) return;

	activeFrame.executeJavaScript(buildVncLivenessBeaconScript()).catch((err) => {
		logWarn("vnc liveness beacon install failed", getErrorMessage(err));
	});

	const detector = createVncLivenessDetector();
	const readExpression = buildVncLivenessBeaconReadExpression();
	const polling = createPollingPolicy({
		name: "vnc-liveness-sampler",
		intervalMs: 1_000,
	}).start(async () => {
		if (document.documentElement?.classList.contains("noVNC_connected") !== true) {
			detector.reset();
			return;
		}
		try {
			const raw: unknown = await activeFrame.executeJavaScript(readExpression);
			const counters = parseVncLivenessBeaconCounters(raw);
			if (counters == null) return;
			const report = detector.sample(performance.now(), counters);
			if (report == null) return;
			activeRenderer.sendToHost(VNC_LIVENESS_CHANNEL, report);
		} catch (err) {
			logWarn("vnc liveness sample failed", getErrorMessage(err));
		}
	});
	window.addEventListener("pagehide", () => polling.dispose(), { once: true });
}

function installVncMacKeyMapping(): void {
	const frame = getWebFrame();
	if (frame == null) return;
	if (!isInteractiveVncPage()) return;

	// macOS sends Cmd (Meta/Super) for copy/paste, but the Linux box expects
	// Ctrl. noVNC owns keyboard handling inside its own ES module scope, so we
	// remap in the page's main world via its exported UI.rfb.sendKey, mirroring
	// the cloud-agent viewer's useVncMacKeyboardMapping.
	const script = `
    (function () {
      if (window.__sandVncMacKeysInstalled) return;
      if (!/Mac/i.test((navigator && navigator.platform) || "")) return;
      window.__sandVncMacKeysInstalled = true;

      var SHORTCUTS = { KeyA: 0x61, KeyC: 0x63, KeyV: 0x76, KeyX: 0x78, KeyZ: 0x7a };
      var CONTROL_L = 0xffe3;
      var SHIFT_L = 0xffe1;
      var HELD_MODIFIERS = [
        [0xffe7, "MetaLeft"], [0xffe8, "MetaRight"],
        [0xffe9, "AltLeft"], [0xffea, "AltRight"],
        [0xffeb, "SuperLeft"], [0xffec, "SuperRight"]
      ];

      var ui = null;
      import("./app/ui.js")
        .then(function (m) { ui = m && m.default; })
        .catch(function () {});

      document.addEventListener("keydown", function (e) {
        if (!e.metaKey) return;
        var keysym = SHORTCUTS[e.code];
        if (keysym === undefined) return;
        var rfb = ui && ui.rfb;
        if (!rfb || typeof rfb.sendKey !== "function") return;
        e.preventDefault();
        e.stopImmediatePropagation();
        // noVNC presses Meta/Alt down for Cmd, so release them first to avoid
        // sending Alt+Ctrl+key instead of a clean Ctrl+key.
        for (var i = 0; i < HELD_MODIFIERS.length; i++) {
          try { rfb.sendKey(HELD_MODIFIERS[i][0], HELD_MODIFIERS[i][1], false); } catch (_e) {}
        }
        rfb.sendKey(CONTROL_L, "ControlLeft", true);
        if (e.shiftKey) rfb.sendKey(SHIFT_L, "ShiftLeft", true);
        rfb.sendKey(keysym, e.code, true);
        rfb.sendKey(keysym, e.code, false);
        if (e.shiftKey) rfb.sendKey(SHIFT_L, "ShiftLeft", false);
        rfb.sendKey(CONTROL_L, "ControlLeft", false);
      }, true);
    })();
  `;
	frame.executeJavaScript(script).catch((err) => {
		logWarn("vnc mac key mapping injection failed", getErrorMessage(err));
	});
}

installSandBrowserPreload();

try {
	installNoVncChromeHider();
} catch (err) {
	logWarn("noVNC chrome hider install failed", getErrorMessage(err));
}

try {
	installVncClipboardBridge();
} catch (err) {
	logWarn("vnc clipboard bridge install failed", getErrorMessage(err));
}

try {
	installVncUserPresenceReporter();
} catch (err) {
	logWarn("vnc user presence reporter install failed", getErrorMessage(err));
}

try {
	installVncHostKeyForwarder();
} catch (err) {
	logWarn("vnc host key forwarder install failed", getErrorMessage(err));
}

try {
	installVncRfbSessionReporter();
} catch (err) {
	logWarn("vnc rfb session reporter install failed", getErrorMessage(err));
}

try {
	installVncMacKeyMapping();
} catch (err) {
	logWarn("vnc mac key mapping install failed", getErrorMessage(err));
}

try {
	installVncLivenessTripwire();
} catch (err) {
	logWarn("vnc liveness tripwire install failed", getErrorMessage(err));
}
